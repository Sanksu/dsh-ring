{
  "name": "dsh-ring",
  "version": "0.1.0",
  "private": false,
  "description": "Tiered turn-completion sounds for DeepSeek Harness — volume slider lives in Settings → General",
  "type": "module",
  "main": "index.mjs",
  "license": "MIT",
  "author": "Sanksu <870889277@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanksu/dsh-ring.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.6 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.1"
  },
  "exports": {
    ".": {
      "default": "./index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
